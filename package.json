{
  "name": "packaging-dashboard",
  "version": "0.1.0",
  "description": "Packaging Inventory & Stock Transfer dashboard for one warehouse and multiple stores",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:local": "node scripts/dev-local.mjs dev",
    "start:local": "node scripts/dev-local.mjs start",
    "build": "next build",
    "start": "next start",
    "seed:demo": "tsx --env-file=.env scripts/seed-demo.ts",
    "db:password": "node scripts/set-database-password.mjs",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20.9"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "exceljs": "^4.4.0",
    "next": "^16.3.8",
    "pg": "^8.23.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sharp": "^0.35.5",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-socket": "^0.2.11",
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/yauzl": "^3.4.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
